# NovaCart Frontend Environment Variables Template

# Production Backend API URL
# If your PHP API is on a subdomain: https://api.yourdomain.com/api
# If your PHP API is reverse-proxied on the same domain: /api
VITE_API_BASE_URL=/api

# (Optional) Supabase Direct Access for Image Uploads (Public/Anon Key is safe for client)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJh...

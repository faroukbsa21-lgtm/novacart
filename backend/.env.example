# ==============================================================================
# SECURE PHP BACKEND CONFIGURATION
# Copy this file to .env and fill in your Supabase credentials
# ==============================================================================

# Application Environment (production or development)
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8000

# CORS Whitelist (Comma-separated list of allowed origins)
# For local dev: http://localhost:5173 (Vite default), http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Supabase Credentials (Found in Supabase Dashboard -> Project Settings -> API)
# NEVER expose the SERVICE_ROLE_KEY to the React frontend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT Authentication Secret (Use a strong random 64+ char string)
# Generate with: openssl rand -base64 48
JWT_SECRET=super-secure-change-this-jwt-secret-key-at-least-64-characters-long-12345
JWT_EXPIRATION_SECONDS=86400

# Rate Limiting Settings
# Maximum requests per minute per IP address
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=120

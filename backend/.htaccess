# ==============================================================================
# HIGH-SECURITY APACHE SERVER CONFIGURATION
# ==============================================================================

# Disable directory browsing
Options -Indexes -MultiViews

# Follow symbolic links
Options +FollowSymLinks

# Turn on URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and sensitive dotfiles (.env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Block access to source code directories directly
    RewriteRule ^src/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule \.(sql|env|log|md|json|lock)$ - [F,L]

    # Handle Authorization Header for Bearer Tokens in FastCGI/PHP-FPM
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect all non-file/dir requests to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Security Headers (Defense in depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
